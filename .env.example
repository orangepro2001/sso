APP_NAME=SSO
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# The service is reachable at <base>/sso through caddy, so APP_URL must carry the path.
APP_URL=http://127.0.0.1:3550/sso

# Bind every interface: requirement is "no IP restriction, public NIC included".
# 0.0.0.0 inside the container (host network), caddy proxies 127.0.0.1:3550 -> /sso.
SSO_LISTEN=0.0.0.0:3550
SSO_TRUSTED_PROXIES=

# Force absolute URLs on https when running behind the tailnet TLS terminator.
SSO_URL_SCHEME=https
# Cookie path / session cookie scope for the /sso mount point.
SESSION_PATH=/sso

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Stateless cookie sessions + database cache keep the rootfs read-only.
SESSION_DRIVER=cookie
SESSION_LIFETIME=720
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync

# PostgreSQL on the AI host, reached over the tailnet. TLS only (hostssl in pg_hba).
DB_CONNECTION=pgsql
DB_HOST=100.101.146.117
DB_PORT=5432
DB_DATABASE=sso
DB_USERNAME=sso
DB_PASSWORD=
DB_SSLMODE=require

# Token lifetimes (seconds).
SSO_ACCESS_TOKEN_TTL=604800
SSO_REFRESH_TOKEN_TTL=2592000
# Guest tokens never expire by default (0 = no expiry).
SSO_GUEST_TOKEN_TTL=0

# Shared secret for the silent guest channel: signature = hex(HMAC-SHA256(secret, "sso-guest-v1\n" + device_id))
SSO_GUEST_SECRET=

# Bootstrap administrator, created on the first boot only (no public registration).
SSO_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
SSO_BOOTSTRAP_ADMIN_NAME=admin
SSO_BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/bootstrap_admin_password
