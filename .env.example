# The Go service reads the same keys the Laravel one did, with the same
# defaults, so an existing .env mostly carries over. Real environment variables
# always win over this file.
APP_NAME=SSO
APP_ENV=production
# The key the avatar URL HMAC and the signing-key encryption are derived from.
# Keep the PHP value: picture URLs already in the wild stay valid.
APP_KEY=
APP_DEBUG=false

# Internal origin (URL generation only; the service has no proxy requirement).
APP_URL=http://127.0.0.1:3550
# Canonical public base URL (own origin). Becomes the JWT "iss" and the base of
# every URL in the discovery document. When this service is mounted under a path
# (/sso), include it here and set SESSION_PATH accordingly.
SSO_ISSUER=https://sso.example.com

# Listen address. 0.0.0.0 by design: the requirement is "no IP restriction".
SSO_LISTEN=0.0.0.0:3550

# Public URL shape for generated links (scheme + mount point).
SSO_URL_SCHEME=https
SSO_FORCE_ROOT_URL=true
# Empty = follow the issuer's own path ("/" for an own origin). Set only when the
# issuer is mounted under a path.
SESSION_PATH=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=720

# The one data file. Everything — users, tokens, keys, audit — lives here.
WR_DB=storage/sso.db
# Where avatar files are written (the database stores "avatars/<id>/<file>").
WR_STORAGE=storage

# Token lifetimes (seconds): 7-day access token, 30-day rotating refresh token.
SSO_ACCESS_TOKEN_TTL=604800
SSO_REFRESH_TOKEN_TTL=2592000
SSO_AUTH_CODE_TTL=300
SSO_RESET_LINK_TTL=86400

# What the console prints times in. The stored clock stays UTC.
SSO_DISPLAY_TIMEZONE=Asia/Seoul

# Bootstrap administrator: created on first boot only (a no-op once one exists).
SSO_BOOTSTRAP_ADMIN_USERNAME=admin
SSO_BOOTSTRAP_ADMIN_NAME=admin
# Use the file in a container; an inline value is fine for a single host.
SSO_BOOTSTRAP_ADMIN_PASSWORD=
SSO_BOOTSTRAP_ADMIN_PASSWORD_FILE=

# Mail is stubbed: users have no address, so password reset links are minted by
# an administrator and logged when they are created.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=sso@localhost

# Logging goes to stderr; the service has no log file of its own.
LOG_LEVEL=info
