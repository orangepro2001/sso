APP_NAME=SSO
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Internal origin the container listens on (framework URL resolution only).
APP_URL=http://127.0.0.1:3550
# Canonical public base URL as seen by clients; becomes the JWT "iss" and the
# base of every URL in the discovery document. Must include the /sso mount point
# and must be a host that public clients can actually resolve -- the tailnet name
# is not one.
SSO_ISSUER=https://example.com/sso

# Bind every interface: requirement is "no IP restriction, public NIC included".
# 0.0.0.0 inside the container (host network), caddy proxies 127.0.0.1:3550 -> /sso.
SSO_LISTEN=0.0.0.0:3550
SSO_TRUSTED_PROXIES=

# Force absolute URLs on https when running behind the tailnet TLS terminator.
SSO_URL_SCHEME=https
# Cookie path / session cookie scope for the /sso mount point.
SESSION_PATH=/sso

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Server-side sessions so a disabled account can actually be logged out; the
# cache lives in the same database. Both keep the container rootfs read-only.
SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync

# PostgreSQL on the AI host, reached over the tailnet. TLS only (hostssl in pg_hba).
DB_CONNECTION=pgsql
DB_HOST=100.101.146.117
DB_PORT=5432
DB_DATABASE=sso
DB_USERNAME=sso
DB_PASSWORD=
DB_SSLMODE=require

# Token lifetimes (seconds).
SSO_ACCESS_TOKEN_TTL=604800
SSO_REFRESH_TOKEN_TTL=2592000
# Guest tokens never expire by default (0 = no expiry).
SSO_GUEST_TOKEN_TTL=0

# Shared secret for the silent guest channel: signature = hex(HMAC-SHA256(secret, "sso-guest-v1\n" + device_id))
SSO_GUEST_SECRET=
# Scope granted to every guest token. Keep it read-only; this is what an unvetted
# machine is allowed to do.
SSO_GUEST_SCOPE=db:read

# Bootstrap administrator, created on the first boot only (no public registration).
SSO_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
SSO_BOOTSTRAP_ADMIN_NAME=admin
SSO_BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/bootstrap_admin_password
