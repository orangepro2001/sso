# Public HTTPS entry point on egg (210.207.108.170, NATed to the NIC 172.22.0.29).
# Served by the rootful Quadlet daily-work-web-caddy.container, which mounts this
# file at /etc/caddy/Caddyfile. Let's Encrypt certificates live in the
# daily-work-web-caddy-data volume, so the name is kept even though it now fronts
# more than daily-work-web.
#
# Only services that are actually running are exposed here:
#   /sso   -> SSO authorization center      (127.0.0.1:3550)
#   /teach -> AFVI web                      (127.0.0.1:8093)
# Everything else answers 404. Deliberately no fallback to a dead backend: a 502
# from a stopped service is an invitation for scanners and tells them nothing true.
#
# Tailnet access is separate and stays on /etc/caddy/Caddyfile (127.0.0.1:8080,
# fronted by tailscale serve); that listener is unaffected by this file.

{
	# Bind only the NIC address: the public 210.207.108.170 is NATed to 172.22.0.29,
	# while tailscaled owns :443 on the tailnet address, so a wildcard 0.0.0.0:443
	# socket would fail with "address already in use" at boot.
	default_bind tcp4/172.22.0.29
	# The tailnet listener (/etc/caddy/Caddyfile) already owns 127.0.0.1:2019, and
	# this instance is managed through the file only, so it needs no admin API.
	admin off
	servers {
		# HTTP/3 needs UDP 443 open in the firewall as well as TCP 443.
		protocols h1 h2 h3
	}
}

# Mount a backend at a path prefix, stripping the prefix before forwarding --
# the same semantics the tailnet listener uses, so both entry points agree.
(prefix) {
	@{args[0]} path /{args[0]} /{args[0]}/*
	handle @{args[0]} {
		uri strip_prefix /{args[0]}
		reverse_proxy {args[1]}
	}
}

521985.xyz {
	tls {
		# Post-quantum hybrid key exchange first (ML-KEM-768 + X25519), classical fallback.
		curves x25519mlkem768 x25519
	}
	encode zstd gzip
	header -Server

	route {
		# Legacy / hand-typed / bookmarked SSO paths without the mount point. The
		# service only ever serves under /sso, so these used to 404 -- which is
		# exactly what a person gets when they bookmark a console page or retype
		# the URL. Bounce them to the real address instead (308 keeps the method, so
		# a form POST survives the hop).
		# Bare paths from before the /sso mount, and the mount itself: both now belong
		# to the authorization center's own origin.
		@legacy_sso_bare path /login /logout /admin /admin/* /oauth/* /.well-known/openid-configuration /.well-known/jwks.json /healthz
		redir @legacy_sso_bare https://sso.521985.xyz{uri} 308

		# The authorization center moved to its own origin (sso.521985.xyz). Everything
		# under /sso still works, as a permanent redirect, so bookmarks and anything an
		# application cached keep pointing somewhere real.
		@legacy_sso_mount path_regexp ^/sso(.*)$
		redir @legacy_sso_mount https://sso.521985.xyz{re.legacy_sso_mount.1} 308

		# AFVI web. The app knows its prefix (AFVI_BASE_PATH=/teach) and keeps it in
		# its own URLs, so unlike /sso the prefix must reach the backend unchanged.
		@teach path /teach /teach/*
		handle @teach {
			reverse_proxy 127.0.0.1:8093
		}

		# 업무일보 moved to its own origin (report.521985.xyz). The old path still works,
		# as a permanent redirect, so bookmarks and anything quoted in chat keep resolving.
		@legacy_report path_regexp ^/report(.*)$
		redir @legacy_report https://report.521985.xyz{re.legacy_report.1} 308

		handle {
			respond "404 page not found" 404
		}
	}

	log {
		output stdout
		format json
	}
}


# ---------------------------------------------------------------------------
# sso.521985.xyz — the authorization center on its own origin.
#
# Its own host is what removes the whole prefix machinery: no strip_prefix, no
# SESSION_PATH=/sso, no cookie-name juggling beside another application, and OIDC
# issuer/redirect values that look like everyone else's.
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# report.521985.xyz — 업무일보 on its own origin.
#
# Same reasoning as the authorization center: its own host removes the mount prefix
# from every URL the application builds, and with it the whole class of
# "link lost its /report" bugs.
# ---------------------------------------------------------------------------
report.521985.xyz {
	tls {
		curves x25519mlkem768 x25519
	}
	encode zstd gzip
	header -Server

	reverse_proxy 127.0.0.1:3560

	log {
		output stdout
		format json
	}
}

sso.521985.xyz {
	tls {
		curves x25519mlkem768 x25519
	}
	encode zstd gzip
	header -Server

	# The service binds loopback and expects root paths; nothing to rewrite.
	reverse_proxy 127.0.0.1:3550

	log {
		output stdout
		format json
	}
}

# release-publish (relhub) on egg: signed app updates. Read-only here: phones check,
# watch (long poll, up to ~60 s) and download; publishing goes to 127.0.0.1:18790
# on this host with an app token and never through the public name.
release.521985.xyz {
	tls {
		curves x25519mlkem768 x25519
	}
	header -Server

	@write not method GET HEAD
	respond @write "read-only" 405

	# No encode: APKs are already compressed, and Range/If-Range resumes need the
	# bytes untouched. Long polls hold the response; keep the upstream patient.
	reverse_proxy 127.0.0.1:18790 {
		transport http {
			read_timeout 90s
		}
		flush_interval -1
	}

	log {
		output stdout
		format json
	}
}

www.521985.xyz {
	tls {
		curves x25519mlkem768 x25519
	}
	redir https://521985.xyz{uri} permanent
}
