# Daily housekeeping for the SSO service.
#
# Expired and revoked tokens are kept until this runs; sso:prune removes only
# rows that can no longer authenticate anything, and old audit entries.
#
# Install (as the same user that runs sso.service):
#   install -m 0644 deploy/quadlet/sso-prune.service ~/.config/systemd/user/
#   install -m 0644 deploy/quadlet/sso-prune.timer   ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now sso-prune.timer

[Unit]
Description=SSO housekeeping (expired tokens, spent codes, old audit rows)
Documentation=https://github.com/orangepro2001/sso

[Service]
Type=oneshot
# One-shot container over the same image and env as the service, network included
# so PostgreSQL over the tailnet is reachable. No tmpfs needed: nothing is written
# outside the database.
ExecStart=/usr/bin/podman run --rm --network=host \
    --env-file=%h/.config/sso/env \
    --security-opt=no-new-privileges \
    localhost/sso:current prune
