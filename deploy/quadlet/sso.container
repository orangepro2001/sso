# SSO — Go binary, SQLite and avatars on the storage volume.
[Unit]
Description=SSO authorization center (OAuth2 / OIDC)
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/sso:current
ContainerName=sso
Network=host
User=65534:65534
Environment=SSO_LISTEN=0.0.0.0:3550
Environment=WR_DB=/app/storage/sso.db
Environment=WR_STORAGE=/app/storage/app/private
EnvironmentFile=%h/.config/sso/env

ReadOnly=true
Tmpfs=/tmp
Volume=sso-storage.volume:/app/storage:Z
Secret=sso-bootstrap-admin-password,type=mount,target=/run/secrets/sso_bootstrap_admin_password,uid=65534,gid=65534,mode=0400

NoNewPrivileges=true
DropCapability=ALL
HealthCmd=["/bin/sh","-c","wget -qO- http://127.0.0.1:3550/healthz >/dev/null"]
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=15s
HealthOnFailure=kill
LogDriver=journald
AutoUpdate=local

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=60

[Install]
WantedBy=default.target
