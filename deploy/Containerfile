# syntax=docker/dockerfile:1.7
#
# SSO — Laravel authorization center.
#
#   podman build -f deploy/Containerfile -t localhost/sso:current .
#
# Multi-stage: dependencies are resolved with the dev toolchain, the runtime image
# carries only what the service needs. No Node/npm: the console is hand-written CSS
# and Blade templates, so there is no asset build step at all.

ARG PHP_VERSION=8.4

###############################################################################
# Stage 1 — PHP dependencies
###############################################################################
FROM docker.io/library/php:${PHP_VERSION}-cli-alpine AS vendor

RUN apk add --no-cache --virtual .build-deps $PHPIZE_DEPS postgresql-dev \
    && apk add --no-cache postgresql-libs \
    && docker-php-ext-install -j"$(nproc)" pdo_pgsql opcache \
    && apk del .build-deps

COPY --from=docker.io/library/composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app

# Dependency resolution first, so the layer is cached until the lock file moves.
COPY composer.json composer.lock symfony.lock* ./
RUN composer install \
        --no-dev \
        --no-interaction \
        --no-scripts \
        --prefer-dist \
        --no-progress \
        --classmap-authoritative

COPY . .
RUN composer dump-autoload --no-dev --classmap-authoritative --no-scripts \
    && rm -rf /app/.git /app/tests /app/deploy

###############################################################################
# Stage 2 — runtime
###############################################################################
FROM docker.io/library/php:${PHP_VERSION}-fpm-alpine AS runtime

LABEL org.opencontainers.image.title="sso" \
      org.opencontainers.image.description="Self-hosted OAuth2 / OIDC authorization center" \
      org.opencontainers.image.source="https://github.com/orangepro2001/sso"

RUN apk add --no-cache nginx supervisor tzdata curl postgresql-libs \
    && apk add --no-cache --virtual .build-deps $PHPIZE_DEPS postgresql-dev \
    && docker-php-ext-install -j"$(nproc)" pdo_pgsql opcache pcntl \
    && apk del .build-deps \
    && rm -rf /var/cache/apk/*

COPY deploy/php/php.ini /usr/local/etc/php/conf.d/99-sso.ini
COPY deploy/nginx/nginx.conf /etc/nginx/nginx.conf
COPY deploy/supervisor/supervisord.conf /etc/supervisor/supervisord.conf
COPY deploy/entrypoint.sh /usr/local/bin/entrypoint

COPY --from=vendor --chown=root:root /app /app

WORKDIR /app

# Writable paths live on tmpfs at runtime (rootfs is read-only); the image just
# needs the directories to exist with the right ownership.
RUN mkdir -p /app/storage/framework/{cache/data,sessions,views} \
             /app/storage/logs /app/bootstrap/cache /run/nginx /var/log/nginx \
    && chown -R nobody:nobody /app/storage /app/bootstrap/cache \
    && chmod 0755 /usr/local/bin/entrypoint \
    && rm -rf /app/public/index.php.bak

ENV APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr \
    SSO_LISTEN=0.0.0.0:3550

EXPOSE 3550

# The app binds its own listener through nginx on 3550 and speaks to PostgreSQL
# over the tailnet; health is a plain HTTP call so no shell is needed.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://127.0.0.1:3550/healthz || exit 1

ENTRYPOINT ["/usr/local/bin/entrypoint"]
CMD ["serve"]
